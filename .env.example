APP_NAME="Network Anomaly Detection System"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
API_PREFIX="/api"
BACKEND_API_URL="http://127.0.0.1:8000"
CORS_ALLOW_ORIGINS=["http://127.0.0.1:8501","http://localhost:8501"]
LOG_LEVEL="INFO"
MAX_PACKETS_PER_PCAP=100000
MAX_UPLOAD_SIZE_BYTES=104857600
PORT_SCAN_UNIQUE_DST_PORTS_THRESHOLD=20
HIGH_TRAFFIC_PACKETS_THRESHOLD=1000
HIGH_TRAFFIC_BYTES_THRESHOLD=5000000
SUSPICIOUS_CONNECTION_RATE_THRESHOLD=100.0
MULTI_TARGET_UNIQUE_DST_IPS_THRESHOLD=30
ISOLATION_FOREST_CONTAMINATION=0.05
ISOLATION_FOREST_RANDOM_STATE=42
